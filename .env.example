# Pratyaya — local and hosted simulation configuration
# Copy this file to .env and replace with your real values. Never commit .env.
# The connection strings below must point to MongoDB Atlas replica-set clusters that support multi-document transactions (not Atlas Serverless).
# The mock provider should use a separate Atlas cluster/project if you need full infrastructure isolation.
# Render supplies PORT automatically to web services. Do not set PORT locally.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TRUST_PROXY=false
REQUEST_BODY_LIMIT=32kb

# Authentication (JWTs issued by the API)
# In production AUTH_JWT_SECRET must be a unique secret of at least 32 characters.
AUTH_JWT_SECRET=dev-only-pratyaya-jwt-secret-change-me-0001
AUTH_ISSUER=pratyaya-api
AUTH_AUDIENCE=pratyaya-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# Demo experience (credential-free "Explore" sessions)
DEMO_SESSION_TTL_SECONDS=7200
DEMO_RATE_LIMIT_WINDOW_MS=900000
DEMO_RATE_LIMIT_MAX=30
DEMO_MAX_ACTIVE_SESSIONS_PER_IP=10
DEMO_AUTO_SEED=true

# MongoDB Atlas — authoritative Pratyaya store (required)
# Paste a credentialed Atlas SRV URI into .env or the hosting secret store.
# This credential-free reserved-domain value is intentionally nonfunctional.
MONGODB_URI=mongodb+srv://cluster.example.invalid/pratyaya?retryWrites=true&w=majority&appName=pratyaya-api

MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_AUTO_INDEX=true

# Worker
WORKER_HEALTH_PORT=4200

# Mock provider (separate Atlas cluster/project recommended for full isolation)
PROVIDER_PORT=4100
PROVIDER_BASE_URL=http://127.0.0.1:4100/provider/alpha
PROVIDER_PUBLIC_URL=http://127.0.0.1:4100
PROVIDER_MONGODB_URI=mongodb+srv://provider.example.invalid/pratyaya_provider?retryWrites=true&w=majority&appName=pratyaya-mock-provider

# Mock provider fault injection (sandbox only; JSON string)
# Example: {"enabled":true,"rules":[{"type":"timeout","enabled":true,"delayMs":30000}]}
PROVIDER_FAULTS={"enabled":false,"rules":[]}

MOCK_PROVIDER_HMAC_SECRET=dev-only-mock-provider-secret-change-me

# Vercel server-side API proxy. Configure this only in Vercel, never in Vite.
# PRATYAYA_API_ORIGIN=https://pratyaya-api-alive7z.onrender.com
# VITE_API_DOCS_URL=https://pratyaya-api-alive7z.onrender.com/api-docs
